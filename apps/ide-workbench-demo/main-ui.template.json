{
  "appId": "preset-math-whiteboard",
  "template": "ide-workbench",
  "mainAreaMode": "split-tabs",
  "allowSplit": true,
  "allowTabs": true,
  "defaultTabContent": "viewport-2d",
  "enabledTabContents": [
    "text-editor",
    "viewport-2d",
    "custom"
  ],
  "elements": {
    "menubar": true,
    "toolbar": true,
    "activitybar": true,
    "leftSidebar": true,
    "rightSidebar": true,
    "bottomPanel": false,
    "statusbar": true,
    "settingsPage": true,
    "keybindingsPage": true
  },
  "viewport": {
    "engine2d": "pixi",
    "engine3d": "none"
  }
}
